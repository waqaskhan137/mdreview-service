# Watcher image (MR-070 / #30): runs the watcher package and spawns a `claude` agent per Sent review,
# authenticated by the operator's Claude SUBSCRIPTION (CLAUDE_CODE_OAUTH_TOKEN from `claude
# setup-token`, NOT an API key). Kept SEPARATE from the stdlib-only service image — Node + the
# claude CLI live ONLY here; the main `Dockerfile` stays python:3.12-slim with no Node.
FROM node:20-bookworm-slim

# python3 for the watcher + mcp packages (stdlib only, no pip), plus the claude CLI via npm.
# Pin the CLI version for reproducible builds (verified to read CLAUDE_CODE_OAUTH_TOKEN).
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code@2.1.190 \
 && npm cache clean --force

# Non-root runtime user with a writable $HOME — `claude` needs ~/.claude scratch (session/state)
# even when auth comes purely from the env token.
RUN useradd -m -u 10001 watcher
WORKDIR /app
# Mirror the service image: copy src/ as a package root and resolve via PYTHONPATH. The watcher needs
# its own `watcher` package plus the `mcp` package (the spawned claude agent's MCP server, launched
# via /app/src/mcp_server.py — see infra/watcher/agent-mcp.json). The src/ launch scripts land under
# /app/watcher/ (distinct from the python package at /app/src/watcher/).
ENV PYTHONPATH=/app/src
COPY src/ ./src/
COPY infra/watcher/ ./watcher/
RUN chown -R watcher:watcher /app

USER watcher
ENV HOME=/home/watcher

# Pre-accept the workspace-trust + onboarding so a fresh-container headless `claude -p` does NOT hang
# on the trust dialog (`claude --help`: the trust dialog is "skipped when Claude is run in directories
# you trust"). Marks /app trusted and onboarding complete for the runtime user.
RUN mkdir -p /home/watcher/.claude \
 && printf '%s' '{"hasCompletedOnboarding":true,"bypassPermissionsModeAccepted":true,"projects":{"/app":{"hasTrustDialogAccepted":true,"hasCompletedProjectOnboarding":true}}}' \
    > /home/watcher/.claude.json

# The watcher refuses to start without WATCH_LAUNCH_CMD (set by compose); MR-070's auth proofs invoke
# `claude ...` directly, so this CMD is only the real-deploy entrypoint.
CMD ["python3", "-m", "watcher"]
