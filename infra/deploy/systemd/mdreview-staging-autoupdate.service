# Health-gated auto-update for the STAGING stack (reuses infra/deploy/auto-update.sh via MDR_* env).
# Distinct unit from mdreview-autoupdate.service so it shares no state with prod's timer/lock/log.
# Install: see infra/deploy/RUNBOOK-staging.md. Runs as the deploy user (docker group), oneshot.
[Unit]
Description=mdreview STAGING auto-update (pull :dev + health-gated recreate)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=rana
WorkingDirectory=/home/rana/mdreview-staging
# All non-secret; the isolation contract lives here. Health/authprobe MUST target :8141, or the gate
# would probe prod's :8140 and false-green a broken :dev.
Environment=MDR_DEPLOY_DIR=/home/rana/mdreview-staging
Environment=MDR_COMPOSE_FILE=docker-compose.staging.yml
Environment=MDR_ENV_FILE=.env.staging
Environment=MDR_SERVICE=mdreview-staging
Environment=MDR_IMAGE=ghcr.io/ranawaqas-ai/mdreview-service:dev
Environment=MDR_HEALTH=http://127.0.0.1:8141/healthz
Environment=MDR_AUTHPROBE=http://127.0.0.1:8141/api/reviews
Environment=MDR_LOG=/home/rana/mdreview-staging/auto-update.log
ExecStart=/home/rana/mdreview-staging/auto-update.sh
TimeoutStartSec=600
