# Copy to infra/deploy/.env.staging on the Kapture host (gitignored, chmod 600) and fill in. The
# staging stack runs the NATIVE hosted plane — NO Google OAuth, NO oauth2-proxy — so it needs only the
# app's own secrets. All are MANDATORY: the compose ${VAR:?} guards AND the app boot guard refuse to
# start without them. Keep every value DISTINCT from prod's.

# HMAC key for the app-owned session cookie + magic-link tokens. Generate once, keep stable (rotating
# it logs out every session):  openssl rand -hex 32
MDREVIEW_SESSION_SECRET=

# HMAC pepper for agent API-token digests (never on the data volume):  openssl rand -hex 32
MDREVIEW_TOKEN_PEPPER=

# INERT proxy secret. The proxy-identity plane is OFF (MDREVIEW_ALLOW_PROXY_PLANE=0 in the compose), so
# this is NEVER used at runtime — it exists only to satisfy config.py's import-time guard, which
# hard-requires a non-empty PROXY_SECRET whenever REQUIRE_AUTH=1 (that guard protects the non-hosted
# path; we satisfy it rather than weaken it). Generate any random value:  openssl rand -hex 32
MDREVIEW_PROXY_SECRET=

# The VERIFIED email crowned owner/admin on this staging instance (never the first registrant). The
# hosted build refuses to boot without it.
MDREVIEW_OWNER_EMAIL=

# --- Real magic-link email delivery (Azure Communication Services SMTP) -----------------------------
# LEAVE BLANK to keep the stub backend (MDREVIEW_ALLOW_STUB_EMAIL=1 in the compose): links are LOGGED,
# not sent. To send real email, provision per infra/deploy/RUNBOOK-email-smtp.md and fill these; a
# non-empty MDREVIEW_SMTP_HOST flips the app to real delivery on redeploy (then drop the stub flag).
# For STAGING the runbook uses an Azure-managed domain (no DNS), whose sender is DoNotReply@<guid>.azurecomm.net.
MDREVIEW_SMTP_HOST=                       # smtp.azurecomm.net  (presence of this switches stub -> real)
MDREVIEW_SMTP_PORT=587                    # 587 STARTTLS (default) | 465 implicit TLS
MDREVIEW_SMTP_USER=                       # ACS: <acs-resource-name>.<entra-app-id>.<tenant-id>
MDREVIEW_SMTP_PASSWORD=                   # the Entra app client secret (owner-provisioned; chmod 600, never commit)
MDREVIEW_SMTP_FROM=                       # a VERIFIED sender on the domain; if blank, falls back to _USER (wrong for ACS)
MDREVIEW_SMTP_STARTTLS=1                  # 1 (STARTTLS on 587) | 0 (only when the port is implicit-TLS 465)
