# Copy to infra/deploy/.env on the Kapture host (gitignored) and fill in. Phase 0 needs the Google
# OAuth client credentials + a cookie secret. No app-side secrets yet (those arrive in Phase 1:
# MDREVIEW_PROXY_SECRET, MDREVIEW_TOKEN_PEPPER).

# Google Cloud -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (type: Web application).
# Authorized redirect URI MUST be exactly:
#   https://app.waqasrana.space/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# 32-byte URL-safe base64 cookie secret. Generate:
#   python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=

# --- Phase 1 app auth (REQUIRED; the app refuses to boot without these) ---
# Shared secret nginx sends as X-Mdreview-Proxy to vouch the cookie-plane identity. It MUST equal the
# value in /etc/nginx/snippets/mdreview-proxy-secret.conf. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MDREVIEW_PROXY_SECRET=
# HMAC pepper for API-token digests (never in the data volume). Generate the same way. Rotating it
# invalidates every issued token.
MDREVIEW_TOKEN_PEPPER=
