# Copy to infra/deploy/.env on the Kapture host (gitignored, chmod 600) and fill in.
#
# Prod runs the NATIVE plane as of v0.2.1 (2026-07-24): the app owns sign-in via magic-link sessions
# (`python -m mdreview.hosted`, MDREVIEW_ALLOW_PROXY_PLANE=0) and oauth2-proxy is retired. Keep this
# file in step with the live host, and re-read it before any release: a missing REQUIRED key does not
# degrade, it stops the container booting. See infra/deploy/RUNBOOK-phase1.md.

# --- REQUIRED: the app refuses to boot without ALL THREE when MDREVIEW_REQUIRE_AUTH=1 ---------------
# Fail-closed check lives in src/mdreview/config.py. On a miss the container exits with:
#   "MDREVIEW_REQUIRE_AUTH is on but MDREVIEW_PROXY_SECRET, MDREVIEW_TOKEN_PEPPER,
#    and/or MDREVIEW_SESSION_SECRET is unset"
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Signs the app's own session cookies. REQUIRED even though it arrived with the native plane, and the
# one that bit us: v0.2.0 rolled to prod without it and the health gate had to roll production back.
# Use a DIFFERENT value per environment. Sharing it with staging would make a staging session valid
# on prod. Rotating it signs everyone out (recoverable: they just sign in again).
MDREVIEW_SESSION_SECRET=

# HMAC pepper for API-token digests (never stored in the data volume). Rotating it INVALIDATES EVERY
# ISSUED TOKEN, so every agent/MCP client must be re-minted. Carry it across upgrades.
MDREVIEW_TOKEN_PEPPER=

# Vouches a proxy-plane identity header. Still REQUIRED by the fail-closed check above, but INERT
# while MDREVIEW_ALLOW_PROXY_PLANE=0 (nothing reads the header). Set any strong random value. If a
# proxy plane is ever re-enabled it MUST equal /etc/nginx/snippets/mdreview-proxy-secret.conf.
MDREVIEW_PROXY_SECRET=

# --- Native plane -----------------------------------------------------------------------------------
# 0 retires the vouched-identity/proxy plane so the app trusts only its own magic-link session or a
# Bearer token. Set in docker-compose.prod.yml; listed here so the coupling is visible.
#   MDREVIEW_ALLOW_PROXY_PLANE=0
# Bootstrap owner: this address is granted owner rights on first sign-in.
MDREVIEW_OWNER_EMAIL=

# --- Magic-link email delivery (REQUIRED in prod: it is the ONLY way to sign in) ---------------------
# Without working delivery nobody can reach the app. Provision + verify per RUNBOOK-email-smtp.md.
# A non-empty MDREVIEW_SMTP_HOST selects real SMTP; otherwise the app refuses to boot unless
# MDREVIEW_ALLOW_STUB_EMAIL=1 (dev only, prints the link to stdout, never for prod).
# Prod sends from a VERIFIED CUSTOM domain (SPF+DKIM+DMARC on mdreview.space). Do NOT fall back to the
# Azure managed *.azurecomm.net GUID domain: external recipients spam-folder it.
MDREVIEW_SMTP_HOST=                       # smtp.azurecomm.net
MDREVIEW_SMTP_PORT=587                    # 587 STARTTLS | 465 implicit TLS
MDREVIEW_SMTP_USER=                       # ACS: <acs-resource-name>.<entra-app-id>.<tenant-id>
MDREVIEW_SMTP_PASSWORD=                   # Entra app client secret (chmod 600, never commit)
MDREVIEW_SMTP_FROM=no-reply@mdreview.space  # a VERIFIED sender on the custom domain
MDREVIEW_SMTP_STARTTLS=1

# --- RETIRED: oauth2-proxy (Phase 0/1) --------------------------------------------------------------
# Kept only so an existing host .env still parses and for rollback to the pre-v0.2.1 stack. The
# oauth2-proxy container is stopped and nginx no longer routes to it. Leave blank on a fresh install.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
