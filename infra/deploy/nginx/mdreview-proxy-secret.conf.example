# Host-only nginx snippet: the shared secret that proves a vouched identity header came THROUGH
# nginx (the cookie plane). Copy to /etc/nginx/snippets/mdreview-proxy-secret.conf, set the value to
# the SAME string as MDREVIEW_PROXY_SECRET in infra/deploy/.env, and chmod 600. NEVER commit the
# real value. The app trusts X-Auth-Request-* only when X-Mdreview-Proxy matches this.
set $mdr_proxy_secret "REPLACE_WITH_MDREVIEW_PROXY_SECRET";
